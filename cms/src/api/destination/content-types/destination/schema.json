{
  "kind": "collectionType",
  "collectionName": "destinations",
  "info": { "singularName": "destination", "pluralName": "destinations", "displayName": "Destination", "description": "Negara / kawasan tujuan" },
  "options": { "draftAndPublish": false },
  "pluginOptions": {},
  "attributes": {
    "name": { "type": "string", "required": true },
    "slug": { "type": "uid", "targetField": "name", "required": true },
    "code": { "type": "string", "required": true, "maxLength": 2, "minLength": 2 },
    "region": { "type": "string", "required": true },
    "network": { "type": "string" },
    "factor": { "type": "decimal", "default": 1, "min": 0 },
    "position": { "type": "integer", "default": 0 },
    "thumb": { "type": "media", "multiple": false, "allowedTypes": ["images"] },
    "banner": { "type": "media", "multiple": false, "allowedTypes": ["images"] },
    "products": { "type": "relation", "relation": "oneToMany", "target": "api::product.product", "mappedBy": "destination" }
  }
}
